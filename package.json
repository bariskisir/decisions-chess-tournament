{
  "name": "decisions-chess-tournament",
  "version": "1.0.1",
  "private": true,
  "description": "LLM chess benchmark arena: double round-robin OpenRouter tournaments with live boards, Elo ratings, usage accounting, and local Stockfish 19 Lite analysis at depth 15.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "tsx scripts/prepare-engine.ts",
    "predev": "tsx scripts/prepare-engine.ts",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "tsx scripts/prepare-engine.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsx scripts/check-comments.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "sass": "1.105.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
